# Copy to .env for local use. In production, set these in your hosting
# platform's environment settings instead. Never commit real values.

# ---- Database -------------------------------------------------------------
# The owner connection runs migrations; the app connection runs the API and
# worker. They can be the same user: the app switches to the restricted
# atlas_app role on every connection.
DATABASE_OWNER_URL=postgresql://atlas_owner:change-me@localhost:5432/atlas
DATABASE_URL=postgresql://atlas_owner:change-me@localhost:5432/atlas

# ---- Clerk (sign-in and workspaces) ---------------------------------------
# Clerk dashboard -> Configure -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk dashboard -> Configure -> API keys -> "Frontend API URL".
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# The web app's address(es), comma-separated.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- File storage (Cloudflare R2, Amazon S3 or local MinIO) ---------------
STORAGE_BUCKET=atlas-uploads
# R2: https://<account-id>.r2.cloudflarestorage.com   S3: leave empty
STORAGE_ENDPOINT_URL=http://localhost:9000
# R2: auto   S3: e.g. eu-west-2
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=atlas-local
STORAGE_SECRET_ACCESS_KEY=change-me-local-only
# S3: AES256   R2 and MinIO: leave empty
STORAGE_SERVER_SIDE_ENCRYPTION=

# ---- App ------------------------------------------------------------------
ENVIRONMENT=development
# Where the web app is served; allowed to call the API.
WEB_ORIGINS=http://localhost:3000
# Where the API is served; used by the web app.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Limits (defaults shown).
MAX_UPLOAD_MB=25
MAX_ROWS=20000
RAW_FILE_RETENTION_DAYS=7

# ---- AI review (optional) ---------------------------------------------------
# Pairs the rules can't decide are checked by a Claude model. Leave the key
# empty to run without AI: those pairs then stay under "needs review".
# Create a key at console.anthropic.com. Only the worker uses it.
ANTHROPIC_API_KEY=
AI_REVIEW_MODEL=claude-opus-5
AI_MAX_PAIRS_PER_DATASET=2000
